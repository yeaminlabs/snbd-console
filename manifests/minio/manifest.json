{
  "id": "minio",
  "name": "MinIO",
  "tag": "Storage",
  "desc": "S3-compatible object storage server. Ideal for backups and large file storage.",
  "version": "latest",
  "type": "compose",
  "installDir": "/opt/snbd/apps/minio",
  "containerName": "snbd-minio",
  "check": "docker ps --format '{{.Names}}' | grep -qx snbd-minio",
  "postInstall": {
    "note": "MinIO API is at port ${MINIO_API_PORT} and Console UI at port ${MINIO_CONSOLE_PORT}. Use SSH tunnel or open these ports. Log in with the credentials you set."
  },
  "form": [
    { "key": "MINIO_API_PORT", "label": "S3 API port", "type": "number", "default": "9001", "required": true },
    { "key": "MINIO_CONSOLE_PORT", "label": "Console UI port", "type": "number", "default": "9002", "required": true },
    { "key": "MINIO_ROOT_USER", "label": "Admin username", "type": "text", "default": "minioadmin", "required": true },
    { "key": "MINIO_ROOT_PASSWORD", "label": "Admin password", "type": "password", "default": "", "required": true, "hint": "Minimum 8 characters." }
  ]
}
