# Copy to /etc/snbd-console.env (chmod 600, owned by root). Read by systemd, so no "export" and no quotes.
NODE_ENV=production
HOST=127.0.0.1
PORT=3101
TRUST_PROXY=127.0.0.1
DATABASE_URL=postgres://snbd@localhost:5432/snbd_console
PUBLIC_PANEL_URL=https://panel.example.com
WHMCS_WEBHOOK_SECRET=
HETZNER_API_TOKEN=
# Lets clients order a VPS from the dashboard: product list + pricing come straight from WHMCS,
# "Order" hands off to its cart/checkout to pay. Leave any of these blank to hide VPS ordering.
WHMCS_API_URL=https://portal.snbdhost.com
WHMCS_API_IDENTIFIER=
WHMCS_API_SECRET=
WHMCS_VPS_GROUP_IDS=
# Slack, Mattermost or Discord incoming-webhook URL. Without it offline alerts are not sent.
ALERT_WEBHOOK_URL=
# ALERT_GRACE_SECONDS=120
# KEY_ROTATE_AFTER_DAYS=30
# HEARTBEAT_RETENTION_DAYS=30
# AUDIT_RETENTION_DAYS=365
