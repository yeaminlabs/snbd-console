[Unit]
Description=SNBD Console API
After=network-online.target postgresql.service
Wants=network-online.target
# A crash-restart loop (e.g. Postgres bouncing during routine OS package updates) must not burn through
# systemd's default 5-tries-in-10s budget and get stuck "failed" waiting for someone to notice and run
# `systemctl start` by hand. Give it a much bigger budget before giving up, and page out the moment it
# actually does give up.
StartLimitIntervalSec=120
StartLimitBurst=20
OnFailure=snbd-api-alert.service

[Service]
User=snbd
WorkingDirectory=/opt/snbd/apps/api
EnvironmentFile=/etc/snbd-console.env
# the private Node 22 installed by scripts/install-production.sh (the system Node is not used)
Environment=PATH=/opt/snbd-node/bin:/usr/local/bin:/usr/bin:/bin
# run tsx directly: pnpm would try to write into its home directory, which this sandbox keeps read-only
ExecStart=/opt/snbd/apps/api/node_modules/.bin/tsx src/server.ts
Restart=always
RestartSec=3
# the process only needs to read its own files and talk to the network
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/snbd/dist
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
