DATABASE_URL=postgres://localhost:5432/snbd_console
PORT=3101
# Public address clients and VPSs use to reach the panel. Must be https:// in production.
PUBLIC_PANEL_URL=http://localhost:3101
# Where signed agent builds live (default: ./dist/releases). Produced by scripts/build-agent.sh
# RELEASES_DIR=
# Shared secret for the WHMCS webhook (min 32 chars). Same value goes in the WHMCS server's "Access Hash".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHMCS_WEBHOOK_SECRET=
# Where the web app lives, for SSO redirects (defaults to PUBLIC_PANEL_URL)
# WEB_URL=
# Hetzner Cloud project API token (read/write). Without it, hetzner servers fall back to the no-op stub.
# HETZNER_API_TOKEN=
# HETZNER_API_URL=https://api.hetzner.cloud/v1
