DATABASE_URL=postgres://localhost:5432/snbd_console
PORT=3101
# Public address clients and VPSs use to reach the panel. Must be https:// in production.
PUBLIC_PANEL_URL=http://localhost:3101
# Where signed agent builds live (default: ./dist/releases). Produced by scripts/build-agent.sh
# RELEASES_DIR=
# Shared secret for the WHMCS webhook (min 32 chars). Same value goes in the WHMCS server's "Access Hash".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHMCS_WEBHOOK_SECRET=
# Where the web app lives, for SSO redirects (defaults to PUBLIC_PANEL_URL)
# WEB_URL=
# Hetzner Cloud project API token (read/write). Without it, hetzner servers fall back to the no-op stub.
# HETZNER_API_TOKEN=
# HETZNER_API_URL=https://api.hetzner.cloud/v1

# Lets clients order a VPS from the dashboard (reads products/pricing from WHMCS, hands off to its
# cart to pay). All four are required together; leave them unset to hide VPS ordering.
#   WHMCS_API_URL          your WHMCS client-area address, e.g. https://portal.snbdhost.com
#   WHMCS_API_IDENTIFIER   Setup > API Credentials in WHMCS
#   WHMCS_API_SECRET       Setup > API Credentials in WHMCS
#   WHMCS_VPS_GROUP_ID     the Product Group ID (Setup > Products/Services > Create/Manage Groups) that holds VPS products
# WHMCS_API_URL=
# WHMCS_API_IDENTIFIER=
# WHMCS_API_SECRET=
# WHMCS_VPS_GROUP_ID=
