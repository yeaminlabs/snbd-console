{
  "name": "snbd-console",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "pnpm --filter @snbd/api dev",
    "dev:web": "pnpm --filter @snbd/web dev",
    "migrate": "pnpm --filter @snbd/api migrate",
    "seed": "pnpm --filter @snbd/api seed",
    "agent": "cd agent && go run .",
    "hetzner:check": "node scripts/hetzner-check.mjs",
    "mock:hetzner": "node scripts/mock-hetzner.mjs",
    "build": "pnpm --filter @snbd/web build",
    "start": "pnpm --filter @snbd/api start",
    "backup": "./scripts/backup-db.sh",
    "rotate-keys": "psql \"$DATABASE_URL\" -c \"update agent_keys set key_set_at = now() - interval '1 year'\"",
    "create-client": "pnpm --filter @snbd/api create-client"
  }
}
